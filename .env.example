# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to start until you replace this placeholder.
JADE_REGISTRY_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JADE_REGISTRY_DATABASE_URL=sqlite:///./jade_registry.db
JADE_REGISTRY_ENV=development
JADE_REGISTRY_ORIGIN=http://127.0.0.1:8000
JADE_REGISTRY_SESSION_SECONDS=28800
# For compose, also set this to a random URL-safe value in .env:
# POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
